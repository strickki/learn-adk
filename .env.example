# Copy to .env and fill in. .env is gitignored, so never commit your real key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here
# Any OpenRouter model ID that supports tool calling (https://openrouter.ai/models).
# Keep it the same in learn-adk and learn-langgraph for fair comparisons.
MODEL=anthropic/claude-haiku-5.5
